{
  "manifest_version": 3,
  "name": "when2meet to Google Calendar",
  "version": "1.0.0",
  "description": "Highlight the best When2Meet windows and open a prefilled Google Calendar draft.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://when2meet.com/*", "https://www.when2meet.com/*"],
      "js": ["storage-bridge.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://when2meet.com/*", "https://www.when2meet.com/*"],
      "js": ["main.js"],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "MAIN"
    }
  ]
}
